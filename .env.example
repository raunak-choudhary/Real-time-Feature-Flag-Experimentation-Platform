# Copy to .env and fill in. .env is gitignored and must never be committed.

# Database. Compose reads these directly; the application reads them via spring-dotenv.
DB_NAME=rexdb
DB_USER=rex_user
DB_PASSWORD=
DB_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/rexdb

# Origins allowed to call the API and open a WebSocket. Comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local container runtime is Colima, not Docker Desktop.
# Testcontainers cannot always resolve the Colima socket on its own, so both are required.
DOCKER_HOST=unix:///Users/YOUR_USERNAME/.colima/default/docker.sock
TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock
