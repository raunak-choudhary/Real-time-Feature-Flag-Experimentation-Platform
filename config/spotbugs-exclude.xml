<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!--
    JPA entities expose mutable associations and dates by design; Hibernate owns their lifecycle
    and a defensive copy would break dirty checking and lazy loading. Listed by package and by
    class rather than suppressed globally, so a plain data holder outside these does not get a
    free pass.
  -->
  <Match>
    <Package name="com.rex.model"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Or>
      <Class name="com.rex.rollout.RolloutSchedule"/>
      <Class name="com.rex.rollout.RolloutStage"/>
    </Or>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!--
    Constructor injected Spring beans. SpotBugs sees a caller supplied object being stored and
    reports EI_EXPOSE_REP2, but the container owns these singletons and no caller holds a
    reference to mutate. This is the standard injection pattern rather than shared mutable state,
    so the exclusion is scoped to the layers where injection happens rather than applied globally.
  -->
  <Match>
    <Package name="~com\.rex\.(api|service|config|realtime|rollout|audit|telemetry)"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Or>
      <Method name="&lt;init&gt;"/>
    </Or>
  </Match>

  <!-- Spring injects these fields, so SpotBugs cannot see them being written. -->
  <Match>
    <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
  </Match>
</FindBugsFilter>
